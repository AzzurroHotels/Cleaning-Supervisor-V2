[Unit]
Description=Send submitted cleaning reports to WhatsApp via OpenClaw
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/cleaning-report-forwarder.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/cleaning-report-forwarder/forwarder.mjs
TimeoutStartSec=300
