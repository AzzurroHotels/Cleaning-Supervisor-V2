# HTTP server
PORT=3000
HOST=0.0.0.0

# Set this to the hostel's timezone so "today" matches the local working day.
TZ=UTC

# Set to 1 when running behind an HTTPS reverse proxy (nginx, Caddy, Traefik).
TRUST_PROXY=0

# How long a sign-in lasts before the user must sign in again.
SESSION_DAYS=7

# Local run defaults (inside Docker these point at /app/data).
# DB_PATH=./data/allen-cleaning.db
# UPLOAD_DIR=./data/uploads
